{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/api/explain",
      "destination": "/api/explain"
    },
    {
      "source": "/api/stripe-checkout",
      "destination": "/api/stripe-checkout"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/espn?path=:path*"
    },
    {
      "source": "/:path*",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "dist/nfl-stats-pro/**"
    }
  }
}
