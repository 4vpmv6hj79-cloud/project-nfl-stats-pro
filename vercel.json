{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/nfl-stats-pro",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://site.api.espn.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/server/server.mjs"
    }
  ]
}
